# Copy to bootstrap/.env on the server and fill in. Gitignored.
#
# This is the ONLY secrets file on the box. Every other secret — app database
# passwords, API tokens, monitoring credentials — belongs in Komodo's Variables
# & Secrets store, referenced from komodo/syncs/*.toml as [[NAME]].
#
# Why these five are the exception: they are needed to start Komodo, so they
# cannot be stored in Komodo. Everything downstream of Komodo goes in Komodo.
#
# All five are `:?` required in bootstrap/docker-compose.yml — compose refuses
# to start rather than booting a Komodo with a blank admin password.

# Cloudflare Tunnel connector token. The only way traffic reaches this box:
# Caddy publishes no host ports.
#   dash.cloudflare.com -> Zero Trust -> Networks -> Tunnels -> Create tunnel
#   -> Cloudflared -> copy the token from the install command.
# Then add a Public Hostname under that tunnel:
#   *.namanvashistha.com  ->  HTTP  ->  caddy:80
# A wildcard, so new services never need a dashboard edit — just a caddy label.
CF_TUNNEL_TOKEN=

# Mongo root password. Read ONLY on the volume's first init: changing it later
# does not change the user, it just locks Core out until you change it back or
# delete the komodo-mongo-data volume.
KOMODO_DB_PASSWORD=

# Creates the admin account, but only on a boot where no users exist.
# Change the password in the UI afterwards, not here.
KOMODO_ADMIN_PASSWORD=

# Signs session tokens. Rotating it logs everyone out; that is its only effect.
#   openssl rand -hex 32
KOMODO_JWT_SECRET=

# Authenticates incoming GitHub webhooks. Only used if you enable webhook
# deploys (see komodo/syncs/infra.toml — polling is the default here).
#   openssl rand -hex 32
KOMODO_WEBHOOK_SECRET=

# --- optional, defaults in bootstrap/docker-compose.yml are fine ---
#   KOMODO_DB_USERNAME     (default: komodo)
#   KOMODO_ADMIN_USERNAME  (default: admin)
#   KOMODO_SERVER_NAME     (default: Local — must match the `[[server]]` name
#                           in komodo/syncs/infra.toml)
#   KOMODO_IMAGE_TAG       (default: 2 — the major version line)
#   KOMODO_HOST            (default: https://komodo.namanvashistha.com)
#   TZ                     (default: Asia/Kolkata)
#
# --- not read from here; passed to deploy.sh on the command line ---
#   PERIPHERY_ONBOARDING_KEY  pairs the host agent with Core. One-time, from
#                             Komodo -> Servers. Prefer the --onboarding-key
#                             flag: sudo drops the env var. See README.md.
#   KOMODO_PERIPHERY_VERSION  pin the agent (default: latest release). Core is
#                             pinned separately by KOMODO_IMAGE_TAG, and a
#                             mismatch raises ServerVersionMismatch.
